{
  "expo": {
    "name": "DebrouillePro",
    "slug": "debrouillepro-mobile",
    "version": "1.0.0",
    "orientation": "portrait",

    "icon": "./assets/branding/debrouillepro-icon.png",

    "scheme": "debrouillepro",

    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,

    "backgroundColor": "#050812",
    "primaryColor": "#7C3AED",

    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.debrouillepro.mobile"
    },

    "android": {
      "package": "com.debrouillepro.mobile",
      "googleServicesFile": "./google-services.json",

      "adaptiveIcon": {
        "backgroundColor": "#0B041F",
        "foregroundImage": "./assets/branding/debrouillepro-mark.png"
      },

      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },

    "web": {
      "output": "static",
      "favicon": "./assets/branding/debrouillepro-icon.png",
      "bundler": "metro"
    },

    "plugins": [
      "expo-router",

      [
        "expo-splash-screen",
        {
          "image": "./assets/branding/debrouillepro-mark.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#050812",

          "dark": {
            "image": "./assets/branding/debrouillepro-mark.png",
            "backgroundColor": "#050812"
          }
        }
      ],

      "expo-video",
      "expo-web-browser",
      "@react-native-google-signin/google-signin"
    ],

    "experiments": {
      "typedRoutes": true,
      "reactCompiler": false
    },

    "extra": {
      "eas": {
        "projectId": "0a1b046d-8df0-4f5c-b9c9-75d418f07ffc"
      }
    }
  }
}
