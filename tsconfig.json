{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noImplicitAny": false,
    "target": "ES2020",
    "jsx": "react-native",
    "downlevelIteration": true,
    "baseUrl": ".",
    "allowImportingTsExtensions": true,
    "noEmit": true,

    "moduleSuffixes": [".native", ".ios", ".android", ""],

    "paths": {
      "@/*": ["./src/*"],
      "@/convex/*": ["./convex/*"],
      "@react-native-clipboard/clipboard": [
        "./src/shims/react-native-clipboard.ts"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "nativewind-env.d.ts"
  ],
  "exclude": ["node_modules", "dist", "build", ".expo", "android", "ios", "_backups"]
}
